# ~/.config/crew/env for the crew user (chmod 600). Read by crew.service.
# Claude Code roles: a long-lived login for unattended runs. Run `claude setup-token` once as crew and paste it here.
CLAUDE_CODE_OAUTH_TOKEN=paste-the-token-from-claude-setup-token
# Codex roles: no token here. Run `codex login --device-auth` once as crew; the login lives in ~/.codex/auth.json.
# Node 22, pnpm, claude and codex for the crew user
PATH=/home/crew/.local/node/bin:/home/crew/.local/bin:/usr/local/bin:/usr/bin:/bin

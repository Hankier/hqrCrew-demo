# Nightly database backup, run by your admin user (not crew). Install with crew-backup.timer in ~/.config/systemd/user/.
[Unit]
Description=Back up every database off-box (age + R2)

[Service]
Type=oneshot
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/hqrCrew-demo/deploy/backup/backup.sh
Nice=10

# ~/.config/crew-backup/backup.env for your admin user (chmod 600). Read by backup.sh.
# Every value below is an example: put in your own containers, paths and bucket.

# age public key (starts with age1…). Make the key pair on your PC: `age-keygen -o ~/crew-backup-key.txt`.
# Only the PUBLIC key goes here; this box can encrypt but never read its backups.
AGE_RECIPIENT=age1replace-with-your-public-key

# rclone remote and bucket (rclone.conf holds a token scoped to this one bucket, Object Read & Write).
RCLONE_DEST=r2:crew-backups

# SQLite apps: name=/path/to/db (paths from `docker inspect`; check them before the first run)
SQLITE_DBS="app=/home/ops/apps/app/data/app.sqlite"

# Postgres: container:user:database (all DBs you can't lose)
PG_DBS="app-postgres:app:app_prod app-postgres:app:app_demo"
PG_GLOBALS="app-postgres:app"

# Status file crew reads before each night shift (group crewshare, 640)
STATUS_FILE=/srv/crew-share/backup-status.json

# Optional: a scrubbed demo dump for crew's golden database (restored, scrubbed and re-dumped here;
# the raw dump never leaves this job)
# CREW_DEMO_SOURCE=app-postgres.app_demo
# CREW_DEMO_DUMP=/srv/crew-share/app_demo.scrubbed.dump
# CREW_SCRUB_SQL=/home/crew/crew/projects/app/scrub.sql

# Optional: push on failure
# NTFY_URL=https://ntfy.sh/your-random-topic
